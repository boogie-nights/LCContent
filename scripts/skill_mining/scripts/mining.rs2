// 429=mine_quick
// 430=found_gem
// 431=prospect
// 432=mine

// Normal Rocks
[oploc1,_mining_rock_normal] @mining_firstswing(get_ore_fast);
[oploc3,_mining_rock_normal] @mining_continue(get_ore_fast);

// Fast Rocks: Iron, Sandstone, Granite
[oploc1,_mining_rock_fast] @mining_firstswing(get_ore_fast);
[oploc3,_mining_rock_fast] @mining_continue(get_ore_fast);

[label,mining_firstswing](label $get_ore)
def_int $is_empty = loc_param(mining_rock_empty);
if ($is_empty = ^true) {
    anim(null, 0);
    mes("There is no ore currently available in this rock.");
   // sound_synth(prospect, 0, 0);
    return;
}

db_find(standard_rock_table:rock, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}

if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("Your inventory is too full to hold any more <db_getfield($data, standard_rock_table:ore_name, 0)>.");
    return;
}

def_int $levelreq = db_getfield($data, standard_rock_table:rock_level, 0);
if (stat(mining) < $levelreq) {
    anim(null, 0);
    ~mesbox("You need a mining level of <tostring($levelreq)> to mine this rock.");
    return;
}

// Macro events
if (afk_event = ^true & loc_category ! mining_rock_macro_gas) {
    //if (loc_param(macro_gas) = null) jump(macro_randomminingrune);
    //jump(macro_randommining);
}

def_obj $pickaxe = ~pickaxe_checker;
if ($pickaxe = null) {
    anim(null, 0);
    ~mesbox("You need a pickaxe to mine this rock. You do not have a pickaxe which you have the Mining level to use.");
    return;
}

def_int $mining_rate = oc_param($pickaxe, mining_rate);
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + $mining_rate);
    p_oploc(1);
    return;
}

anim(oc_param($pickaxe, mining_animation), 0);
mes("You swing your pick at the rock.");
if (%action_delay = map_clock) {
    jump($get_ore);
}
p_oploc(3);

[label,mining_continue](label $get_ore)
db_find(standard_rock_table:rock, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}

if (inv_freespace(inv) < 1) {
    anim(null, 0);
    ~mesbox("Your inventory is too full to hold any more <db_getfield($data, standard_rock_table:ore_name, 0)>.");
    return;
}

def_int $levelreq = db_getfield($data, standard_rock_table:rock_level, 0);
if (stat(mining) < $levelreq) {
    anim(null, 0);
    ~mesbox("You need a mining level of <tostring($levelreq)> to mine this rock.");
    return;
}

def_obj $pickaxe = ~pickaxe_checker;
if ($pickaxe = null) {
    anim(null, 0);
    ~mesbox("You need a pickaxe to mine this rock. You do not have a pickaxe which you have the Mining level to use.");
    return;
}

def_int $mining_rate = oc_param($pickaxe, mining_rate);

// sounds and skill anim is based off https://youtu.be/ix4_VVi9Xm4
//sound_synth(mine_quick, 0, 0);

// if roll is due
if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + $mining_rate);
} else if (%action_delay = map_clock) {
    anim(oc_param($pickaxe, mining_animation), 0);
    jump($get_ore);
}
p_oploc(3);

[label,get_ore_fast]
db_find(standard_rock_table:rock, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}

// Roll for Gem
def_int $chance = ~calc_gem_chance();
if (random($chance) = ^true) {
    @roll_for_gem($data);
}

// Roll to give ore
if (stat_random(mining, db_getfield($data, standard_rock_table:rock_successchance, 0)) = true) {
    @give_ore($data);
}

p_oploc(3);

[label,give_ore](dbrow $data)

// They added a 1t p_delay in this update: https://oldschool.runescape.wiki/w/Update:Special_Attacks
// I'm assuming this had only applied to non-fast rocks based on 244/245 code
if (loc_category = mining_rock_normal) {
    p_delay(0);
    mes("We p_delayed, boss.");
}

// Determine respawn timer for rock, and update the loc to the depleted version.
def_int $respawn = ~scale_by_playercount(db_getfield($data, standard_rock_table:rock_respawnrate, 0));
loc_change(loc_param(next_loc_stage_mining), $respawn);

// Play sound effect and reset animation.
sound_synth(mine, 0, 0);
anim(null, 0);

// Add ore to inventory, give xp, and display message.

// The 'perfect' gold rocks in Family Crest are the same ID as regular gold rocks, so check to 
// give out the right ore if we're in that location. Only gold rocks are in this room.
def_namedobj $output = db_getfield($data, standard_rock_table:rock_output, 0);
// if(inzone(^crest_perfect_mine_lower_bound, ^crest_perfect_mine_upper_bound, coord) = true) {
//     $output = perfect_gold_ore;
// }
inv_add(inv, $output, 1);
stat_advance(mining, db_getfield($data, standard_rock_table:rock_exp, 0));
mes("You manage to mine some <db_getfield($data, standard_rock_table:ore_name, 0)>.");

[label,roll_for_gem](dbrow $data)
def_namedobj $gem = ~mining_gem_table;
if (gem ! null) {
    inv_add(inv, $gem, 1);
    db_find(gem_cutting_table:uncut_gem, $gem);
    $data = db_findnext;
    mes("You just found <~add_article(oc_name(db_getfield($data, gem_cutting_table:cut_gem, 0)))>!");
}
p_oploc(3);

[proc,calc_gem_chance]()(int)
def_int $chance = 256;

// Check if we're wearing any Amulet of Glory
def_obj $neck = inv_getobj(worn, ^wearpos_front);
if ($neck ! null & oc_category($neck) = category_557 & map_members = ^true) {
    $chance = 86;
}
return ($chance);

[proc,mining_gem_table]()(namedobj)
def_int $rand = random(128);
if ($rand < 2) return (uncut_diamond);
if ($rand < 10) return (uncut_ruby);
if ($rand < 26) return (uncut_emerald);
if ($rand < 58) return (uncut_sapphire);
else return(null);