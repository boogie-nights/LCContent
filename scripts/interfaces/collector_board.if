colour=0xFF7D1F
hAlign=Center
vAlign=Center
font=495
shadow=yes
text="You are about to enter the Bounty Hunter minigame.<br><br>This is not a safe area - it involves player versus player combat and, if you die, you will lose all the items you are carrying!<br><br>If you kill players that are not your target, you will not be able to use the Protect Item prayer. Also you cannot drop items on the floor worth over 1000 gp."

