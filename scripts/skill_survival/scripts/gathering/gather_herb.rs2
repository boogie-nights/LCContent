// Note: Denotes these with mapfunction 20
// Perhaps use loc_2753, to have it be less minimap clutter
[oploc1,herb_bush_common] @attempt_herb_harvest;
[oploc3,herb_bush_common] @herb_harvest;

[label,attempt_herb_harvest]
db_find(herb_nodes:node, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}

if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}

def_obj $secateurs = ~secateurs_checker;
if ($secateurs = null) {
    anim(null, 0);
    mes("You must have a set of secateurs to harvest these herbs.");
    return;
} 

def_int $level = db_getfield($data, herb_nodes:levelrequired, 0);
if (stat(survival) < $level) {
    anim(null, 0);
    mes("You need a higher Survival level to harvest these herbs.");
    return;
}

if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
    p_oploc(1);
    return;
}

anim(oc_param($secateurs, gathering_animation), 0);
mes("You search the bush for some herbs...");
if (%action_delay = map_clock) {
    @get_herbs($data);
}

p_oploc(3);

[label,herb_harvest]
db_find(herb_nodes:node, loc_type);
def_dbrow $data = db_findnext;
if ($data = null) {
    ~displaymessage(^dm_default);
    return;
}

if (map_members = ^false) {
    mes(^mes_members_feature);
    return;
}

def_obj $secateurs = ~secateurs_checker;
if ($secateurs = null) {
    anim(null, 0);
    mes("You must have a set of secateurs to harvest these herbs.");
    return;
} 

def_int $level = db_getfield($data, herb_nodes:levelrequired, 0);
if (stat(survival) < $level) {
    anim(null, 0);
    mes("You need a higher Survival level to harvest these herbs.");
    return;
}

if (%action_delay < map_clock) {
    %action_delay = calc(map_clock + 4);
} else if (%action_delay = map_clock) {
    anim(oc_param($secateurs, gathering_animation), 0);
    @get_herbs($data);
}

p_oploc(3);

[label,get_herbs](dbrow $data)
// get lows and highs
def_int $herb_chance_low;
def_int $herb_chance_high;
$herb_chance_low, $herb_chance_high = ~gathering_successchance($data);
def_int $respawnrate = db_getfield($data, herb_nodes:respawnrate, 0);
def_loc $herb_loc = db_getfield($data, herb_nodes:node, 0);
def_int $deplete_chance = 5; // 1/5 chance to deplete

if (stat_random(survival, $herb_chance_low, $herb_chance_high) = true) {
    mes("You get an herb.");
    stat_advance(survival, db_getfield($data, herb_nodes:productexp, 0));
    inv_add(inv, ~gathering_roll_for_herb($herb_loc), 1);
    if (random($deplete_chance) = 0) {
        $respawnrate = ~scale_by_playercount($respawnrate);
        loc_change(loc_param(next_loc_stage), $respawnrate);
        anim(null, 0);
        return;
    }
}
p_oploc(3);

[proc,gathering_successchance](dbrow $data)(int, int)
def_int $count = calc(db_getfieldcount($data, herb_nodes:successchance) - 1);
def_int $herb_chance_low;
def_int $herb_chance_high;
$herb_chance_low, $herb_chance_high = db_getfield($data, herb_nodes:successchance, $count);
return($herb_chance_low, $herb_chance_high);

[proc,gathering_roll_for_herb](loc $loc)(namedobj)
switch_loc($loc) {
    case herb_bush_common       : return(~gathering_herb_t1);
    case herb_bush_uncommon     : return(~gathering_herb_t2);
    case herb_bush_rare         : return(~gathering_herb_t3);
    case herb_bush_very_rare    : return(~gathering_herb_t4);
}

[proc,gathering_herb_t1]()(namedobj)
return (unidentified_guam);

[proc,gathering_herb_t2]()(namedobj)
return (unidentified_guam);

[proc,gathering_herb_t3]()(namedobj)
return (unidentified_guam);

[proc,gathering_herb_t4]()(namedobj)
return (unidentified_guam);


